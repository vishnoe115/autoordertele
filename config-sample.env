# ============================================================
# AutoOrderTele - sample configuration
# Copy to config.env before running:
#   cp config-sample.env config.env
# Never commit config.env with real secrets.
# ============================================================

# Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_USER_ID=123456789

# Public HTTPS URL that forwards to this container.
# Required only when KlikQRIS is enabled.
PUBLIC_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/webhook/klikqris

# KlikQRIS
# Leave BOTH empty to disable automatic QRIS and run manual DANA only.
KLIKRIS_API_KEY=YOUR_KLIKRIS_API_KEY
KLIKRIS_MERCHANT_ID=YOUR_MERCHANT_ID

# true = sandbox, false = production
KLIKRIS_SANDBOX=true

# Manual DANA / static QRIS fallback
DANA_NUMBER=081234567890
DANA_NAME=Nama Penerima
MANUAL_QRIS_IMAGE=./data/dana_qris.png

# Persistence
DB_PATH=./data/orders.db

# Background status check. Minimum accepted value: 15 seconds.
STATUS_POLL_SECONDS=30
HTTP_TIMEOUT_SECONDS=30

# Internal HTTP server
HOST=0.0.0.0
PORT=8080

# Host port exposed by Docker Compose.
APP_PORT=8080

# Logs
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log
