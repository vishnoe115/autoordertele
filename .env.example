# Compatibility copy of config-sample.env.
# Recommended Docker setup uses config.env.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_USER_ID=123456789

# Telegram channel for transaction/payment-proof logging.
# Recommended: numeric channel ID such as -1001234567890.
# The bot must be an admin/member of the channel with Post Messages permission.
PAYMENT_CHANNEL_ID=-1001234567890

# Recommended for a real @mention notification in the channel.
# Write without @. If blank, the bot falls back to ADMIN_USER_ID clickable mention.
OWNER_MENTION_USERNAME=your_admin_username
OWNER_MENTION_LABEL=Owner
PUBLIC_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/webhook/klikqris
KLIKRIS_API_KEY=YOUR_KLIKRIS_API_KEY
KLIKRIS_MERCHANT_ID=YOUR_MERCHANT_ID
KLIKRIS_SANDBOX=true
DANA_NUMBER=081234567890
DANA_NAME=Nama Penerima
MANUAL_QRIS_IMAGE=./data/dana_qris.png
DB_PATH=./data/orders.db
STATUS_POLL_SECONDS=30
HTTP_TIMEOUT_SECONDS=30
HOST=0.0.0.0
PORT=8080
APP_PORT=8080
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log
