# Compatibility copy of config-sample.env.
# Recommended Docker setup uses config.env.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_USER_ID=123456789
PUBLIC_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/webhook/klikqris
KLIKRIS_API_KEY=YOUR_KLIKRIS_API_KEY
KLIKRIS_MERCHANT_ID=YOUR_MERCHANT_ID
KLIKRIS_SANDBOX=true
DANA_NUMBER=081234567890
DANA_NAME=Nama Penerima
MANUAL_QRIS_IMAGE=./data/dana_qris.png
DB_PATH=./data/orders.db
STATUS_POLL_SECONDS=30
HTTP_TIMEOUT_SECONDS=30
HOST=0.0.0.0
PORT=8080
APP_PORT=8080
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log
